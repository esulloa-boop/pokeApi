{
  "name": "peta-pokedex",
  "version": "1.0.0",
  "description": "Pokédex con Ionic y Angular: listado y detalle usando PokéAPI.",
  "private": true,
  "scripts": {
    "start": "ionic serve --no-open",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "ionic:serve": "ng serve",
    "ionic:build": "ng build",
    "cap:sync": "npm run build && cap sync"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/router": "~20.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@ionic/angular": "9.0.10",
    "ionicons": "^8.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@capacitor/cli": "^8.6.0",
    "@ionic/cli": "7.2.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  }
}
